[?2004l[?2004h>  elif dh<-180: dh+=360
[?2004l[?2004h>  dH=2*math.sqrt(C1p*C2p)*math.sin(math.radians(dh/2))
[?2004l[?2004h>  Lb=(L1+L2)/2; Cbp=(C1p+C2p)/2
[?2004l[?2004h>  if C1p*C2p==0: hb=h1+h2
