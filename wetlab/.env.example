# Copy to wetlab/.env, chmod 600, then fill values locally.
# Generate each gateway secret independently, e.g. secrets.token_hex(32).
WETLAB_ADMIN_TOKEN=replace-with-a-random-admin-secret
WETLAB_SIGNING_KEY=replace-with-a-different-random-signing-secret
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_API_BASE=https://tokenhub.tencentmaas.com/v1
# Optional: absolute directory on a large disk for signed filesystem archives.
# WETLAB_ARCHIVE_DIR=/absolute/path/to/wetlab-archives
