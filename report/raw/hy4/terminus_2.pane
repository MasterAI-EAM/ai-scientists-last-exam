[?2004l[?2004h>             for _ in range(excess):
[?2004l[?2004h>                 m=max(rec[:3]);idx=rec[:3].index(m);rec[idx]-=1
[?2004l[?2004h>         ff=[x/200 for x in rec]
[?2004l[?2004h>         mix=tuple(sum(ff[q]*E[k][ch] for q,k in enumerate('RGBW')) for ch in range(3))
[?2004l[?2004h>         p=inv(mix)
[?2004l[?2004h>         print(' target',ti,'target coord',tuple(round(x,1) for x in y),'frac',[round(z,4) for z in f],'rounded rec',tuple(rec),'predLab',tuple(round(x,2) for x in p),'dE',round(de2000(p,t),2))
[?2004l[?2004h>         # local integer optimization under this model
