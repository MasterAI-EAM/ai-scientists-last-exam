[?2004l[?2004h>  else: hb=(h1+h2+360)/2 if h1+h2<360 else (h1+h2-360)/2
[?2004l[?2004h>  T=1-0.17*math.cos(math.radians(hb-30))+0.24*math.cos(math.radians(2*hb))+0.32*math.cos(math.radians(3*hb+6))-0.20*math.cos(math.radians(4*hb-63))
[?2004l[?2004h>  dth=30*math.exp(-((hb-275)/25)**2)
[?2004l[?2004h>  Rc=2*math.sqrt(Cbp**7/(Cbp**7+25**7))
