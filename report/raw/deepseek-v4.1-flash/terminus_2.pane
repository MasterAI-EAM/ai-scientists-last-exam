[?2004l[?2004h>  Sh=1+0.015*Cbp*T
[?2004l[?2004h>  Rt=-math.sin(math.radians(2*dth))*Rc
[?2004l[?2004h>  return math.sqrt((dL/Sl)**2+(dC/Sc)**2+(dH/Sh)**2+Rt*(dC/Sc)*(dH/Sh))
