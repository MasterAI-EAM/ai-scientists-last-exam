[?2004l[?2004h>         return (12.92*c if c<=0.0031308 else 1.055*c**(1/2.4)-0.055)*255
[?2004l[?2004h>     return tuple(one(c) for c in lin)
[?2004l[?2004h> def gamma_to_lin(g):
[?2004l[?2004h>     def one(x):
[?2004l[?2004h>         c=x/255;s=-1 if c<0 else 1;c=abs(c)
[?2004l[?2004h>         return s*(c/12.92 if c<=0.04045 else ((c+0.055)/1.055)**2.4)
[?2004l[?2004h>     return tuple(one(x) for x in g)
[?2004l[?2004h> def lab_to_lin(l):return matvec(MINV,lab_to_xyz(l))
[?2004l[?2004h> def lin_to_lab(v):return xyz_to_lab(matvec(M,v))
[?2004l[?2004h> def lab_to_gamma(l):return lin_to_gamma(lab_to_lin(l))
[?2004l[?2004h> def gamma_to_lab(g):return lin_to_lab(gamma_to_lin(g))
[?2004l[?2004h> 
[?2004l[?2004h> def mix_geometric(rec,transform,invtransform,eps=1e-6):
[?2004l[?2004h>     T={k:transform(v) for k,v in ends.items()}
[?2004l[?2004h>     f=[q/200 for q in rec]
[?2004l[?2004h>     vals=[]
[?2004l[?2004h>     for ch in range(3):
[?2004l[?2004h>         s=sum(f[q]*math.log(max(eps,T[k][ch])) for q,k in enumerate('RGBW'))
[?2004l[?2004h>         vals.append(math.exp(s))
[?2004l[?2004h>     return invtransform(tuple(vals))
[?2004l[?2004h> 
[?2004l[?2004h> spaces={}
[?2004l[?2004h> spaces['XYZ']=(lab_to_xyz,xyz_to_lab)
[?2004l[?2004h> spaces['XYZnorm']=(lambda l:tuple(lab_to_xyz(l)[i]/D65[i] for i in range(3)),lambda v:xyz_to_lab(tuple(v[i]*D65[i] for i in range(3))))
[?2004l[?2004h> spaces['linRGBclip']=(lambda l:tuple(max(1e-5,x) for x in lab_to_lin(l)),lambda v:lin_to_lab(v))
[?2004l[?2004h> spaces['gammaRGBclip']=(lambda l:tuple(max(1e-3,x) for x in lab_to_gamma(l)),lambda v:gamma_to_lab(v))
[?2004l[?2004h> # cone-like matrices applied to XYZ
[?2004l[?2004h> cone_mats={
[?2004l[?2004h> 'Bradford':((0.8951,0.2664,-0.1614),(-0.7502,1.7135,0.0367),(0.0389,-0.0685,1.0296)),
[?2004l[?2004h> 'CAT02':((0.7328,0.4296,-0.1624),(-0.7036,1.6975,0.0061),(0.0030,0.0136,0.9834)),
[?2004l[?2004h> 'Sharp':((1.2694,-0.0988,-0.1706),(-0.8364,1.8006,0.0357),(0.0297,-0.0315,1.0018)),
[?2004l[?2004h> }
[?2004l[?2004h> for n,A in cone_mats.items():
[?2004l[?2004h>     Ainv=None
[?2004l[?2004h>     # invert 3x3 via determinant formula
[?2004l[?2004h>     a,b,c=A[0];d,e,f=A[1];g,h,i=A[2]
[?2004l[?2004h>     det=a*(e*i-f*h)-b*(d*i-f*g)+c*(d*h-e*g)
[?2004l[?2004h>     Ainv=((e*i-f*h)/det,(c*h-b*i)/det,(b*f-c*e)/det,(f*g-d*i)/det,(a*i-c*g)/det,(c*d-a*f)/det,(d*h-e*g)/det,(b*g-a*h)/det,(a*e-b*d)/det)
[?2004l[?2004h>     spaces[n]=(lambda l,A=A:matvec(A,lab_to_xyz(l)),lambda v,Ainv=Ainv:xyz_to_lab(matvec(Ainv,v)))
[?2004l[?2004h> 
[?2004l[?2004h> for name,(fwd,inv) in spaces.items():
[?2004l[?2004h>     ds=[];preds=[]
[?2004l[?2004h>     for rec,o in obs:
[?2004l[?2004h>         try:
[?2004l[?2004h>             p=mix_geometric(rec,fwd,inv);d=de2000(p,o)
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             p=(0,0,0);d=99
[?2004l[?2004h>         ds.append(d);preds.append(p)
[?2004l[?2004h>     print(name,'dE',[round(x,2) for x in ds],'sum',round(sum(ds),2))
[?2004l[?2004h>     if sum(ds)<30:
[?2004l[?2004h>         for rec,o,p in zip(obs[:4],[x for _,x in obs[:4]],preds[:4]):print('  ',rec,'pred',tuple(round(x,2) for x in p),'obs',tuple(round(x,2) for x in o))
