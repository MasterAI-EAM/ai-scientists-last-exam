[?2004l[?2004h>         try:f=solve(A,b)
[?2004l[?2004h>         except Exception as e:print(' target',ti,'solve failed',e);continue
[?2004l[?2004h>         rec0=tuple(max(0,round(200*z)) for z in f[:3]);w=200-sum(rec0)
[?2004l[?2004h>         # adjust sum while nonnegative
