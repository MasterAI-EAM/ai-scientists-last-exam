[?2004l[?2004h> print('Base gamma RGB:')
[?2004l[?2004h> for k,v in base.items(): print(k,tuple(round(x,1) for x in lab_to_gamma(v)))
[?2004l[?2004h> 
[?2004l[?2004h> def lsq1(rows,y):
[?2004l[?2004h>     # scalar linear LS over rows with coefficients for water channel (one unknown): y - sum(fixed) = fw*W
[?2004l[?2004h>     num=sum(r[0]*yy for r,yy in zip(rows,y)); den=sum(r[0]**2 for r in rows)
[?2004l[?2004h>     return num/den if den else 0
[?2004l[?2004h> 
[?2004l[?2004h> def fit(space, clip_neg=False):
[?2004l[?2004h>     fwd,inv=spaces[space]
[?2004l[?2004h>     B={k:list(fwd(v)) for k,v in base.items()}
[?2004l[?2004h>     if clip_neg:
[?2004l[?2004h>         for k in B: B[k]=[max(0,x) for x in B[k]]
[?2004l[?2004h>     # estimate W coordinate channel by channel from all 4 observations
[?2004l[?2004h>     W=[]; pred=[]
[?2004l[?2004h>     for ch in range(3):
[?2004l[?2004h>         rows=[]; y=[]
[?2004l[?2004h>         for rec,o in obs:
[?2004l[?2004h>             fixed=sum((rec[q]/200)*B[k][ch] for q,k in enumerate('RGB'))
[?2004l[?2004h>             rows.append([rec[3]/200]); y.append(fwd(o)[ch]-fixed)
[?2004l[?2004h>         W.append(lsq1(rows,y))
[?2004l[?2004h>     for rec,o in obs:
[?2004l[?2004h>         c=tuple(sum((rec[q]/200)*B[k][ch] for q,k in enumerate('RGB'))+(rec[3]/200)*W[ch] for ch in range(3))
[?2004l[?2004h>         p=inv(c); pred.append((p,de2000(p,o)))
[?2004l[?2004h>     return W,pred
[?2004l[?2004h> 
[?2004l[?2004h> for space in spaces:
[?2004l[?2004h>     W,pred=fit(space)
[?2004l[?2004h>     print('\nSPACE',space,'fitted water',tuple(round(x,2) for x in W),'dE',[round(d,2) for _,d in pred],'sum',round(sum(d for _,d in pred),2))
[?2004l[?2004h>     print(' predictions',[tuple(round(x,2) for x in p) for p,_ in pred])
