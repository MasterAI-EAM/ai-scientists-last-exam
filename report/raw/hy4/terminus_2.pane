[?2004l[?2004h> 
[?2004l[?2004h> def lab_to_xyz(lab):
[?2004l[?2004h>     L,a,b=lab; fy=(L+16)/116; fx=fy+a/500; fz=fy-b/200
[?2004l[?2004h>     inv=lambda f:f**3 if f**3>E else (116*f-16)/K
[?2004l[?2004h>     return tuple(D65[i]*inv((fx,fy,fz)[i]) for i in range(3))
[?2004l[?2004h> def xyz_to_lab(xyz):
[?2004l[?2004h>     q=[xyz[i]/D65[i] for i in range(3)]
[?2004l[?2004h>     def f(x):
[?2004l[?2004h>         if x>E: return math.cbrt(x)
[?2004l[?2004h>         return (K*x+16)/116 if x>=0 else -abs(x)**(1/3)
[?2004l[?2004h>     fv=[f(x) for x in q]
[?2004l[?2004h>     return (116*fv[1]-16,500*(fv[0]-fv[1]),200*(fv[1]-fv[2]))
[?2004l[?2004h> def lin_to_gamma(lin):
[?2004l[?2004h>     def one(c):
[?2004l[?2004h>         if c<0: return -((1.055*(-c)**(1/2.4)-0.055)*255 if -c>0.0031308 else 12.92*(-c)*255)
[?2004l[?2004h>         return (12.92*c if c<=0.0031308 else 1.055*c**(1/2.4)-0.055)*255
[?2004l[?2004h>     return tuple(one(c) for c in lin)
[?2004l[?2004h> def gamma_to_lin(g):
[?2004l[?2004h>     def one(x):
[?2004l[?2004h>         c=x/255; s=-1 if c<0 else 1; c=abs(c)
[?2004l[?2004h>         return s*(c/12.92 if c<=0.04045 else ((c+0.055)/1.055)**2.4)
[?2004l[?2004h>     return tuple(one(x) for x in g)
[?2004l[?2004h> def lab_to_gamma(lab): return lin_to_gamma(matvec(MINV,lab_to_xyz(lab)))
[?2004l[?2004h> def gamma_to_lab(g): return xyz_to_lab(matvec(M,gamma_to_lin(g)))
[?2004l[?2004h> def lab_to_xyz_v(lab): return lab_to_xyz(lab)
[?2004l[?2004h> 
[?2004l[?2004h> spaces={
[?2004l[?2004h>  'Lab': (lambda x:x, lambda x:x),
[?2004l[?2004h>  'XYZ': (lab_to_xyz, xyz_to_lab),
