[?2004l[?2004h>  C1p=math.hypot(a1p,b1); C2p=math.hypot(a2p,b2)
[?2004l[?2004h>  h1=math.degrees(math.atan2(b1,a1p))%360; h2=math.degrees(math.atan2(b2,a2p))%360
[?2004l[?2004h>  dL=L2-L1; dC=C2p-C1p
[?2004l[?2004h>  dh=0 if C1p*C2p==0 else h2-h1
