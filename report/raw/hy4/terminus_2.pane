[?2004l[?2004h[01;32magent@292682be5b0a[00m:[01;34m/workspace[00m$ cat > /workspace/refine.py <<'PY'
[?2004l[?2004h> import json,math,random
[?2004l[?2004h> from color_math import de2000
[?2004l[?2004h> h=json.load(open('/workspace/history.json'))
[?2004l[?2004h> obs=[]
[?2004l[?2004h> for ev in h['events']:
[?2004l[?2004h>  if ev.get('status')!='accepted':continue
[?2004l[?2004h>  for w in ev['wells']:
[?2004l[?2004h>   r=w['recipe'];obs.append(((r['Red'],r['Green'],r['Blue'],r['water']),tuple(w['observed_lab']),ev['attempt_id']))
[?2004l[?2004h> targets=[(72.41,-71.63,32.26),(70.67,-48.25,20.20),(66.61,-15.79,-12.81),(64.69,-30.37,8.42)]
[?2004l[?2004h> starts=[x[0] for x in obs[-4:]]
[?2004l[?2004h> def solve(A,b):
[?2004l[?2004h>  n=len(A);M=[list(map(float,r))+[float(y)] for r,y in zip(A,b)]
[?2004l[?2004h>  for j in range(n):
[?2004l[?2004h>   p=max(range(j,n),key=lambda i:abs(M[i][j]));M[j],M[p]=M[p],M[j]
[?2004l[?2004h>   if abs(M[j][j])<1e-10:raise ValueError('singular')
[?2004l[?2004h>   for i in range(n):
[?2004l[?2004h>    if i==j:continue
[?2004l[?2004h>    z=M[i][j]/M[j][j]
[?2004l[?2004h>    for k in range(j,n+1):M[i][k]-=z*M[j][k]
[?2004l[?2004h>  return [M[i][n]/M[i][i] for i in range(n)]
[?2004l[?2004h> def feature(rec,deg=2):
[?2004l[?2004h>  x=[v/200 for v in rec[:3]];r,g,b=x
[?2004l[?2004h>  if deg==1:return [1.,r,g,b]
[?2004l[?2004h>  if deg==2:return [1.,r,g,b,r*r,g*g,b*b,r*g,r*b,g*b]
[?2004l[?2004h>  if deg==3:return [1.,r,g,b,r*r,g*g,b*b,r*g,r*b,g*b,r**3,g**3,b**3,r*r*g,r*r*b,g*g*r,g*g*b,b*b*r,b*b*g,r*g*b]
[?2004l[?2004h> def fit(rows,deg,lam):
[?2004l[?2004h>  X=[feature(r,deg) for r,_,_ in rows];Y=[o for _,o,_ in rows];p=len(X[0]);C=[]
[?2004l[?2004h>  for ch in range(3):
[?2004l[?2004h>   A=[[sum(x[i]*x[j] for x in X)+(lam if i==j else 0) for j in range(p)] for i in range(p)]
[?2004l[?2004h>   b=[sum(x[i]*y[ch] for x,y in zip(X,Y)) for i in range(p)]
[?2004l[?2004h>   C.append(solve(A,b))
[?2004l[?2004h>  return C
[?2004l[?2004h> def pred(C,rec,deg):
[?2004l[?2004h>  f=feature(rec,deg);return tuple(sum(c[i]*f[i] for i in range(len(f))) for c in C)
[?2004l[?2004h> def loo(deg,lam):
[?2004l[?2004h>  e=[]
[?2004l[?2004h>  for k,(r,o,_) in enumerate(obs):
[?2004l[?2004h>   C=fit(obs[:k]+obs[k+1:],deg,lam);e.append(de2000(pred(C,r,deg),o))
[?2004l[?2004h>  return e
[?2004l[?2004h> print('LOO model comparison:')
[?2004l[?2004h> for deg in (1,2,3):
[?2004l[?2004h>  for lam in (1e-5,1e-3,0.01,0.1):
[?2004l[?2004h>   try:
[?2004l[?2004h>    e=loo(deg,lam);print(' deg',deg,'lam',lam,'sum',round(sum(e),2),'last4',[round(x,2) for x in e[-4:]])
[?2004l[?2004h>   except Exception as ex:print(' fail',deg,lam,ex)
[?2004l[?2004h> deg,lam=2,0.01
[?2004l[?2004h> C=fit(obs,deg,lam)
[?2004l[?2004h> print('\nCHOSE deg',deg,'lam',lam,'in-sample all',[round(de2000(pred(C,r,deg),o),2) for r,o,_ in obs])
[?2004l[?2004h> def p(rec):return pred(C,rec,deg)
[?2004l[?2004h> def jac(rec,h=1.0):
[?2004l[?2004h>  J=[[0]*3 for _ in range(3)]
[?2004l[?2004h>  for j in range(3):
[?2004l[?2004h>   a=list(rec);b=list(rec);a[j]+=h;a[3]-=h;b[j]-=h;b[3]+=h
[?2004l[?2004h>   pa=p(tuple(a));pb=p(tuple(b))
[?2004l[?2004h>   for ch in range(3):J[ch][j]=(pa[ch]-pb[ch])/(2*h)
[?2004l[?2004h>  return J
[?2004l[?2004h> def valid(rec):return min(rec)>=0 and sum(rec)==200
[?2004l[?2004h> def make_rec(r,g,b):return (r,g,b,200-r-g-b)
[?2004l[?2004h> for ti,(t,start) in enumerate(zip(targets,starts),1):
[?2004l[?2004h>  print('\nTARGET',ti,'start',start,'observed',obs[-4+ti-1][1],'currentDE',round(de2000(obs[-4+ti-1][1],t),3))
[?2004l[?2004h>  o=obs[-4+ti-1][1];res=tuple(t[ch]-o[ch] for ch in range(3))
[?2004l[?2004h>  print(' raw Lab residual target-observed',tuple(round(x,2) for x in res),'surrogate prediction',tuple(round(x,2) for x in p(start)))
[?2004l[?2004h>  J=jac(start)
[?2004l[?2004h>  print(' Jacobian per uL (rows Lab, cols dR,dG,dB with dW=-sum)',[[round(x,3) for x in row] for row in J])
[?2004l[?2004h>  # Newton with surrogate residual (correct model bias using observed point: p_adjusted = p(rec)+(observed-p(start)))
[?2004l[?2004h>  def padj(rec):
[?2004l[?2004h>   pp=p(rec);return tuple(pp[ch]+(o[ch]-p(start)[ch]) for ch in range(3))
[?2004l[?2004h>  best=[]
[?2004l[?2004h>  # Solve J delta=target-observed
[?2004l[?2004h>  try:
[?2004l[?2004h>   delta=solve(J,list(res))
[?2004l[?2004h>  except Exception as e:
[?2004l[?2004h>   print(' solve failed',e);delta=[0,0,0]
[?2004l[?2004h>  print(' raw linear Newton delta',[round(x,1) for x in delta])
[?2004l[?2004h>  for scale in (0.5,0.75,1.0,1.25,1.5):
[?2004l[?2004h>   rec=tuple(round(start[j]+scale*delta[j]) for j in range(3));rec=make_rec(*rec)
[?2004l[?2004h>   if valid(rec):
[?2004l[?2004h>    best.append((de2000(padj(rec),t),rec,tuple(round(x,2) for x in padj(rec)),'newton'+str(scale)))
[?2004l[?2004h>  # grid around start +/-20 µL, with local bias correction
[?2004l[?2004h>  for dr in range(-16,17,2):
[?2004l[?2004h>   for dg in range(-16,17,2):
[?2004l[?2004h>    for db in range(-16,17,2):
[?2004l[?2004h>     rec=tuple(start[j]+[dr,dg,db][j] for j in range(3));rec=make_rec(*rec)
[?2004l[?2004h>     if not valid(rec):continue
[?2004l[?2004h>     d=de2000(padj(rec),t)
[?2004l[?2004h>     best.append((d,rec,tuple(round(x,2) for x in padj(rec)),'grid'))
[?2004l[?2004h>  best.sort()
[?2004l[?2004h>  for b in best[:10]:print(' candidate',b[1],'predAdj',b[2],'predDE',round(b[0],3),b[3])
[?2004l[?2004h> PY
