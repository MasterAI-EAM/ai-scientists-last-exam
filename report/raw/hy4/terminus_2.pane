[?2004l[?2004h> spaces={}
[?2004l[?2004h> spaces['sRGB']=(lambda l:lab_to_rgb(l),lambda v:rgb_to_lab(v))
[?2004l[?2004h> spaces['linearRGB']=(lambda l:srgb_to_lin(lab_to_rgb(l)),lambda v:rgb_to_lab(lin_to_srgb(v)))
[?2004l[?2004h> spaces['Lab']=(lambda l:l,lambda v:v)
[?2004l[?2004h> for name,(fwd,inv) in spaces.items():
