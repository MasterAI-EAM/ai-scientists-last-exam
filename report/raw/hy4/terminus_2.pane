[?2004l[?2004h>      ((4,70,56,70),(72.03769428866704,-47.17056751792203,28.184299171193636)),
[?2004l[?2004h>      ((2,94,44,60),(72.64391152515444,-48.61101637151604,36.37735608071229))]
