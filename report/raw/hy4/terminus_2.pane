[?2004l[?2004h>     E={k:fwd(v) for k,v in ends.items()}
[?2004l[?2004h>     print(' endpoints:',{k:tuple(round(x,2) for x in v) for k,v in E.items()})
[?2004l[?2004h>     for ti,t in enumerate(targets,1):
