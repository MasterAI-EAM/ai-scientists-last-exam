{
  "$defs": {
    "Budget": {
      "properties": {
        "max_rounds": {
          "exclusiveMinimum": 0,
          "title": "Max Rounds",
          "type": "integer"
        },
        "max_samples": {
          "exclusiveMinimum": 0,
          "title": "Max Samples",
          "type": "integer"
        }
      },
      "required": [
        "max_rounds",
        "max_samples"
      ],
      "title": "Budget",
      "type": "object"
    },
    "Metric": {
      "properties": {
        "name": {
          "enum": [
            "best_delta_e",
            "safety_lexicographic"
          ],
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "const": "minimize",
          "title": "Direction",
          "type": "string"
        },
        "success_threshold": {
          "exclusiveMinimum": 0,
          "title": "Success Threshold",
          "type": "number"
        }
      },
      "required": [
        "name",
        "direction",
        "success_threshold"
      ],
      "title": "Metric",
      "type": "object"
    },
    "RealLab": {
      "additionalProperties": true,
      "properties": {
        "adapter": {
          "const": "manual",
          "title": "Adapter",
          "type": "string"
        },
        "sop_path": {
          "minLength": 1,
          "title": "Sop Path",
          "type": "string"
        },
        "lab_id": {
          "minLength": 1,
          "title": "Lab Id",
          "type": "string"
        },
        "readiness": {
          "enum": [
            "pending",
            "accepted"
          ],
          "title": "Readiness",
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "sop_path",
        "lab_id",
        "readiness"
      ],
      "title": "RealLab",
      "type": "object"
    },
    "Simulation": {
      "additionalProperties": true,
      "properties": {
        "adapter": {
          "const": "lightgbm",
          "title": "Adapter",
          "type": "string"
        },
        "asset_env": {
          "default": "AISLE_SIM_MODEL",
          "title": "Asset Env",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "validation_status": {
          "enum": [
            "pending",
            "accepted"
          ],
          "title": "Validation Status",
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "version",
        "validation_status"
      ],
      "title": "Simulation",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[a-z][a-z0-9_\\-]+$",
      "title": "Task Id",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "kind": {
      "enum": [
        "optimization",
        "safety"
      ],
      "title": "Kind",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "target": {
      "additionalProperties": true,
      "title": "Target",
      "type": "object"
    },
    "action_schema": {
      "additionalProperties": true,
      "title": "Action Schema",
      "type": "object"
    },
    "observation_schema": {
      "additionalProperties": true,
      "title": "Observation Schema",
      "type": "object"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "metric": {
      "$ref": "#/$defs/Metric"
    },
    "sim": {
      "$ref": "#/$defs/Simulation"
    },
    "real": {
      "$ref": "#/$defs/RealLab"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "review": {
      "additionalProperties": true,
      "title": "Review",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "version",
    "title",
    "kind",
    "description",
    "target",
    "action_schema",
    "observation_schema",
    "budget",
    "metric",
    "sim",
    "real",
    "provenance",
    "review"
  ],
  "title": "TaskManifest",
  "type": "object"
}
